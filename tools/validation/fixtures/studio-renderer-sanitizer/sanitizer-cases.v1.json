        "mustContain": [
          "t"
        ],
        "mustNotContain": [
          "style=",
          "position:fixed",
          "javascript:"
        ],
        "idempotent": true
      }
    },
    {
      "id": "neg-mutation-xss-noscript",
      "kind": "negative",
      "requirement": "noscript mutation vector neutralized",
      "input": "<noscript><p title=\"</noscript><img src=x onerror=alert(1)>\">t</p></noscript><p>k</p>",
      "expect": {
        "mustContain": [
          "k"
        ],
        "mustNotContain": [
          "<noscript",
          "onerror",
          "alert(1)"
        ],
        "idempotent": true
      }
    },
    {
      "id": "neg-mutation-xss-mglyph",
