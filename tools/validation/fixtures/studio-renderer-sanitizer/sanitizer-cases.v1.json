        ],
        "idempotent": true
      }
    },
    {
      "id": "neg-template-element",
      "kind": "negative",
      "requirement": "template element removed",
      "input": "<template><img src=x onerror=alert(1)></template><p>k</p>",
      "expect": {
        "mustContain": [
          "k"
        ],
        "mustNotContain": [
          "<template",
          "onerror",
          "alert(1)"
        ],
        "idempotent": true
      }
    },
    {
      "id": "neg-link-element",
      "kind": "negative",
      "requirement": "link element removed",
      "input": "<link rel=\"stylesheet\" href=\"https://evil.test/x.css\"><p>k</p>",
      "expect": {
        "mustContain": [
          "k"
        ],
        "mustNotContain": [
          "<link",
          "stylesheet"
        ],
        "idempotent": true
      }
    }
  ],
  "urlCases": [
    {
      "id": "url-https-link",
      "context": "link",
      "input": "https://example.test/a",
      "allowed": true,
      "reason": "scheme-allowed"
    },
    {
      "id": "url-http-link",
      "context": "link",
      "input": "http://example.test/a",
      "allowed": true,
      "reason": "scheme-allowed"
    },
    {
      "id": "url-mailto-link",
      "context": "link",
      "input": "mailto:a@b.test",
      "allowed": true,
      "reason": "scheme-allowed"
    },
    {
      "id": "url-tel-link",
      "context": "link",
      "input": "tel:+15550100",
      "allowed": true,
      "reason": "scheme-allowed"
    },
    {
      "id": "url-relative-link",
      "context": "link",
